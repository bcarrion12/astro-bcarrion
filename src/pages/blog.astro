---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="Blog — BCARRION" active="blog" description="Notas y actualizaciones sobre Andromeda y bcarrion.">
  <section class="relative z-10 pt-[180px] px-[6vw] pb-[60px] text-center">
    <p class="tracking-[.3em] uppercase text-muted text-[11px] mb-5">ANDROMEDA</p>
    <h1 class="font-display font-normal text-[clamp(36px,6vw,64px)] m-0 text-fg">Blog</h1>
    <p class="text-muted max-w-[440px] mx-auto mt-5 text-sm leading-[1.7]">
      <span class="lang-es">Notas y actualizaciones sobre Andromeda y bcarrion.</span>
      <span class="lang-en">Notes and updates on Andromeda and bcarrion.</span>
    </p>
  </section>

  <section class="relative z-10 max-w-[760px] mx-auto pt-10 px-[6vw] pb-[150px]">
    {posts.map((post) => (
      <div class="group grid grid-cols-[110px_1fr] gap-7 py-[30px] px-1 border-b border-border text-left transition-colors duration-300 hover:border-fg">
        <div class="font-mono text-xs text-faint tracking-[.03em] pt-[3px]">
          <span class="lang-es">{post.data.es.date}</span><span class="lang-en">{post.data.en.date}</span>
        </div>
        <div>
          <div class="font-display text-[19px] text-fg mb-2 transition-transform duration-300 group-hover:translate-x-1">
            <span class="lang-es">{post.data.es.title}</span><span class="lang-en">{post.data.en.title}</span>
          </div>
          <div class="text-muted text-sm leading-[1.7] max-w-[520px]">
            <span class="lang-es">{post.data.es.excerpt}</span><span class="lang-en">{post.data.en.excerpt}</span>
          </div>
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
