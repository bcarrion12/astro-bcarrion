---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="BCARRION — Andromeda" active="home">
  <section style="position:relative; z-index:1; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:140px 6vw 80px; text-align:center;">
    <div style="position:absolute; top:100px; left:36px; width:22px; height:22px; border-top:1px solid var(--border); border-left:1px solid var(--border);"></div>
    <div style="position:absolute; top:100px; right:36px; width:22px; height:22px; border-top:1px solid var(--border); border-right:1px solid var(--border);"></div>
    <div style="position:absolute; bottom:36px; left:36px; width:22px; height:22px; border-bottom:1px solid var(--border); border-left:1px solid var(--border);"></div>
    <div style="position:absolute; bottom:36px; right:36px; width:22px; height:22px; border-bottom:1px solid var(--border); border-right:1px solid var(--border);"></div>
    <div style="position:absolute; top:20%; right:10%; width:150px; height:150px; border-radius:50%; border:1px dashed var(--border);"></div>
    <div style="position:absolute; top:24%; left:50%; transform:translate(-50%,-50%); width:520px; height:280px; background:radial-gradient(circle, oklch(60% 0.15 300 / .25), transparent 70%); filter:blur(60px); pointer-events:none;"></div>
    <div style="position:absolute; top:38%; left:38%; width:340px; height:220px; background:radial-gradient(circle, oklch(65% 0.14 190 / .2), transparent 70%); filter:blur(50px); pointer-events:none;"></div>

    <div style="width:8px; height:8px; border-radius:50%; background:var(--accent); margin-bottom:44px; animation:breathe 3.5s ease-in-out infinite;"></div>

    <p style="letter-spacing:.4em; text-transform:uppercase; color:var(--muted); font-size:11px; margin:0 0 28px;">
      <span class="lang-es">Nuevo álbum · 15.08.2026</span><span class="lang-en">New album · 08.15.2026</span>
    </p>
    <h1 style="font-family:'Space Grotesk',sans-serif; font-weight:400; font-size:clamp(48px,10vw,120px); line-height:1; margin:0; letter-spacing:-.01em; color:var(--fg);">ANDROMEDA</h1>
    <p style="margin:32px 0 56px; max-width:480px; color:var(--muted); font-size:15px; line-height:1.7;">
      <span class="lang-es">Un viaje sonoro entre galaxias. Lo nuevo de bcarrion.</span>
      <span class="lang-en">A sonic journey between galaxies. The new record from bcarrion.</span>
    </p>

    <div style="display:flex; gap:48px; margin-bottom:64px;">
      <div style="text-align:center;">
        <div id="cd-d" style="font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:300; color:var(--fg); letter-spacing:-.02em;">00</div>
        <div style="font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin-top:8px;"><span class="lang-es">Días</span><span class="lang-en">Days</span></div>
      </div>
      <div style="text-align:center;">
        <div id="cd-h" style="font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:300; color:var(--fg); letter-spacing:-.02em;">00</div>
        <div style="font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin-top:8px;"><span class="lang-es">Hrs</span><span class="lang-en">Hrs</span></div>
      </div>
      <div style="text-align:center;">
        <div id="cd-m" style="font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:300; color:var(--fg); letter-spacing:-.02em;">00</div>
        <div style="font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin-top:8px;"><span class="lang-es">Min</span><span class="lang-en">Min</span></div>
      </div>
      <div style="text-align:center;">
        <div id="cd-s" style="font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:300; color:var(--fg); letter-spacing:-.02em;">00</div>
        <div style="font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin-top:8px;"><span class="lang-es">Seg</span><span class="lang-en">Sec</span></div>
      </div>
    </div>

    <div style="display:flex; gap:16px; flex-wrap:wrap; justify-content:center;">
      <a href="#preorder" class="cta-solid">
        <span class="lang-es">Reservar ahora</span><span class="lang-en">Pre-order now</span>
      </a>
      <a href="/tracklist" class="cta-outline">
        <span class="lang-es">Ver tracklist</span><span class="lang-en">View tracklist</span>
      </a>
    </div>

    <div style="position:relative; width:min(560px,80vw); aspect-ratio:1; margin-top:96px; border-radius:2px; overflow:hidden; border:1px solid var(--border); animation:drift 8s ease-in-out infinite; display:flex; align-items:center; justify-content:center; background:repeating-linear-gradient(45deg, var(--borderSoft), var(--borderSoft) 10px, transparent 10px, transparent 20px);">
      <span style="font-family:monospace; font-size:12px; color:var(--faint);">portada del álbum</span>
    </div>
  </section>

  <section id="preorder" style="position:relative; z-index:1; padding:160px 6vw; text-align:center; border-top:1px solid var(--borderSoft);">
    <p style="letter-spacing:.3em; text-transform:uppercase; color:var(--muted); font-size:11px; margin:0 0 20px;">
      <span class="lang-es">Disponible ahora</span><span class="lang-en">Available now</span>
    </p>
    <h2 style="font-family:'Space Grotesk',sans-serif; font-weight:400; font-size:clamp(26px,3.4vw,38px); margin:0 0 64px; color:var(--fg);">
      <span class="lang-es">Preorder</span><span class="lang-en">Pre-order</span>
    </h2>
    <div style="display:flex; flex-direction:column; max-width:420px; margin:0 auto;">
      {['Spotify', 'Apple Music', 'YouTube Music'].map((name) => (
        <a href="#" style="display:flex; align-items:center; justify-content:space-between; padding:22px 4px; border-bottom:1px solid var(--border); color:var(--fg); font-size:15px;">
          <span>{name}</span>
          <span style="color:var(--faint); font-size:13px;">&#8594;</span>
        </a>
      ))}
    </div>
  </section>

  <section style="position:relative; z-index:1; padding:0 6vw 140px; text-align:center;">
    <p style="letter-spacing:.3em; text-transform:uppercase; color:var(--muted); font-size:11px; margin:0 0 28px;">
      <span class="lang-es">Seguime</span><span class="lang-en">Follow</span>
    </p>
    <div style="display:flex; gap:32px; justify-content:center; flex-wrap:wrap;">
      {['Instagram', 'TikTok', 'YouTube', 'SoundCloud'].map((name) => (
        <a href="#" style="color:var(--muted); font-size:13px; letter-spacing:.05em;">{name}</a>
      ))}
    </div>
  </section>

  <script>
    import { startCountdown } from '../scripts/site.js';
    startCountdown('2026-08-15T00:00:00', ['cd-d', 'cd-h', 'cd-m', 'cd-s']);
  </script>
</BaseLayout>
