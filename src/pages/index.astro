---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import albumCover from '../assets/album_cover.jpg';
---
<BaseLayout title="BCARRION — Andromeda" active="home" description="Andromeda, el nuevo álbum de bcarrion. Un viaje sonoro entre galaxias — disponible el 15 de agosto de 2026.">
  <section class="relative z-10 min-h-screen flex flex-col items-center justify-center py-[140px] px-[6vw] pb-20 text-center">
    <div class="absolute top-[100px] left-9 w-[22px] h-[22px] border-t border-l border-border"></div>
    <div class="absolute top-[100px] right-9 w-[22px] h-[22px] border-t border-r border-border"></div>
    <div class="absolute bottom-9 left-9 w-[22px] h-[22px] border-b border-l border-border"></div>
    <div class="absolute bottom-9 right-9 w-[22px] h-[22px] border-b border-r border-border"></div>
    <div class="absolute top-[20%] right-[10%] w-[150px] h-[150px] rounded-full border border-dashed border-border"></div>
    <div class="absolute top-[24%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] h-[280px] pointer-events-none blur-[60px]" style="background:radial-gradient(circle, oklch(60% 0.15 300 / .25), transparent 70%);"></div>
    <div class="absolute top-[38%] left-[38%] w-[340px] h-[220px] pointer-events-none blur-[50px]" style="background:radial-gradient(circle, oklch(65% 0.14 190 / .2), transparent 70%);"></div>

    <div class="w-2 h-2 rounded-full bg-accent mb-11 animate-breathe"></div>

    <p class="eyebrow mb-7">
      <span class="lang-es">Nuevo álbum · 15.08.2026</span><span class="lang-en">New album · 08.15.2026</span>
    </p>
    <h1 class="relative font-display font-bold text-[clamp(48px,10vw,120px)] leading-none m-0 tracking-[-.03em] text-fg">ANDROMEDA</h1>
    <p class="my-8 mb-14 max-w-[480px] text-muted text-[15px] leading-[1.7]">
      <span class="lang-es">Un viaje sonoro entre galaxias. Lo nuevo de bcarrion.</span>
      <span class="lang-en">A sonic journey between galaxies. The new record from bcarrion.</span>
    </p>

    <div class="flex gap-12 mb-16">
      <div class="text-center">
        <div id="cd-d" class="font-display text-[32px] font-light text-fg tracking-[-.02em]">00</div>
        <div class="text-[10px] tracking-[.2em] uppercase text-faint mt-2"><span class="lang-es">Días</span><span class="lang-en">Days</span></div>
      </div>
      <div class="text-center">
        <div id="cd-h" class="font-display text-[32px] font-light text-fg tracking-[-.02em]">00</div>
        <div class="text-[10px] tracking-[.2em] uppercase text-faint mt-2"><span class="lang-es">Hrs</span><span class="lang-en">Hrs</span></div>
      </div>
      <div class="text-center">
        <div id="cd-m" class="font-display text-[32px] font-light text-fg tracking-[-.02em]">00</div>
        <div class="text-[10px] tracking-[.2em] uppercase text-faint mt-2"><span class="lang-es">Min</span><span class="lang-en">Min</span></div>
      </div>
      <div class="text-center">
        <div id="cd-s" class="font-display text-[32px] font-light text-fg tracking-[-.02em]">00</div>
        <div class="text-[10px] tracking-[.2em] uppercase text-faint mt-2"><span class="lang-es">Seg</span><span class="lang-en">Sec</span></div>
      </div>
    </div>

    <div class="flex gap-4 flex-wrap justify-center">
      <a href="#preorder" class="cta-solid">
        <span class="lang-es">Reservar ahora</span><span class="lang-en">Pre-order now</span>
      </a>
      <a href="/tracklist" class="cta-outline">
        <span class="lang-es">Ver tracklist</span><span class="lang-en">View tracklist</span>
      </a>
    </div>

    <div class="placeholder-tile relative w-[min(560px,80vw)] aspect-square mt-24 rounded-sm overflow-hidden border border-border animate-drift">
      <Image
        src={albumCover}
        alt="Portada de Andromeda, de bcarrion"
        widths={[400, 700, 1000]}
        sizes="(min-width: 768px) 560px, 80vw"
        format="webp"
        quality={85}
        loading="eager"
        class="w-full h-full object-cover"
      />
    </div>
  </section>

  <section id="preorder" class="relative z-10 py-40 px-[6vw] text-center border-t border-border-soft">
    <p class="eyebrow mb-5">
      <span class="lang-es">Disponible ahora</span><span class="lang-en">Available now</span>
    </p>
    <h2 class="font-display font-bold text-[clamp(26px,3.4vw,38px)] mb-16 text-fg">
      <span class="lang-es">Preorder</span><span class="lang-en">Pre-order</span>
    </h2>
    <div class="grid gap-5 sm:grid-cols-3 max-w-[720px] mx-auto text-left">
      {[
        { name: 'Spotify', href: 'https://open.spotify.com/intl-es/artist/0d5Qkw7d2Rk4S7FPTiCpPQ?si=wHOj9405Q5iOOF4C-Fh_Wg' },
        { name: 'Apple Music', href: '#' },
        { name: 'YouTube Music', href: '#' }
      ].map(({ name, href }) => (
        <a href={href} target={href !== '#' ? '_blank' : undefined} rel={href !== '#' ? 'noopener noreferrer' : undefined} class="card group flex flex-col">
          <div class="card-icon">{name.charAt(0)}</div>
          <div class="flex items-center justify-between">
            <span class="text-fg text-[15px] font-medium transition-transform duration-300 group-hover:translate-x-1">{name}</span>
            <span class="text-faint text-[13px] transition-transform duration-300 group-hover:translate-x-1">&#8594;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="relative z-10 px-[6vw] pb-[140px] text-center">
    <p class="eyebrow mb-7">
      <span class="lang-es">Seguime</span><span class="lang-en">Follow</span>
    </p>
    <div class="flex gap-8 justify-center flex-wrap">
      {[
        { name: 'Instagram', href: 'https://www.instagram.com/bcarrion12' },
        { name: 'TikTok', href: '#' },
        { name: 'YouTube', href: '#' },
        { name: 'SoundCloud', href: '#' }
      ].map(({ name, href }) => (
        <a href={href} target={href !== '#' ? '_blank' : undefined} rel={href !== '#' ? 'noopener noreferrer' : undefined} class="text-muted text-[13px] tracking-[.05em] transition-colors duration-300 hover:text-fg">{name}</a>
      ))}
    </div>
  </section>

  <script>
    import { startCountdown } from '../scripts/site.js';
    let countdownId: ReturnType<typeof setInterval>;
    document.addEventListener('astro:page-load', () => {
      const el = document.getElementById('cd-d');
      if (!el) return;
      clearInterval(countdownId);
      countdownId = startCountdown('2026-08-15T00:00:00', ['cd-d', 'cd-h', 'cd-m', 'cd-s']);
    });
  </script>
</BaseLayout>
