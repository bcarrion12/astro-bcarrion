---
import BaseLayout from '../layouts/BaseLayout.astro';
const gallery = [1, 2, 3, 4, 5, 6];
---
<BaseLayout title="Álbum — BCARRION" active="album" description="El álbum Andromeda de bcarrion: video destacado y galería.">
  <section class="relative z-10 max-w-[860px] mx-auto px-[6vw] pt-[180px] pb-[140px] text-center overflow-hidden">
    <div class="marquee absolute top-[70px] left-0 pointer-events-none select-none" aria-hidden="true">
      <div class="marquee-track">
        <span>Andromeda · Video · Andromeda · Video · </span>
        <span>Andromeda · Video · Andromeda · Video · </span>
      </div>
    </div>
    <p class="eyebrow mb-5">
      <span class="lang-es">Andromeda</span><span class="lang-en">Andromeda</span>
    </p>
    <h1 class="font-display font-bold text-[clamp(30px,4.5vw,48px)] mb-10 text-fg">
      <span class="lang-es">Video destacado</span><span class="lang-en">Featured video</span>
    </h1>
    <div class="placeholder-tile relative w-full aspect-video overflow-hidden border border-border flex items-center justify-center">
      <button type="button" class="flex items-center gap-3 bg-fg text-bg font-semibold text-[13px] tracking-[.03em] rounded-full py-3 px-6 cursor-pointer border-0" aria-label="Ver video">
        <span class="flex items-center justify-center w-5 h-5 rounded-full bg-bg text-fg shrink-0">
          <span class="block w-0 h-0 border-t-[5px] border-t-transparent border-b-[5px] border-b-transparent border-l-[8px] border-l-fg ml-[2px]"></span>
        </span>
        <span class="lang-es">VER VIDEO</span><span class="lang-en">WATCH VIDEO</span>
      </button>
    </div>
  </section>

  <section class="relative z-10 max-w-[1080px] mx-auto px-[6vw] pb-[150px] text-center">
    <p class="eyebrow mb-10">
      <span class="lang-es">Galería</span><span class="lang-en">Gallery</span>
    </p>
    <div class="grid gap-0.5" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
      {gallery.map((n) => (
        <div class="placeholder-tile aspect-square overflow-hidden flex items-center justify-center transition-transform duration-300 hover:scale-[1.03] cursor-pointer">
          <span class="font-mono text-[11px] text-faint">foto {n}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
