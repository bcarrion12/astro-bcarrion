---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const albums = await getCollection('albums', ({ data }) => data.published);
  return albums.map((album) => ({
    params: { slug: album.id },
    props: { album }
  }));
}

const { album } = Astro.props;
const tracks = album.data.tracks;
const releaseEs = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
  album.data.releaseDate
);
const releaseEn = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(
  album.data.releaseDate
);
---
<BaseLayout
  title={`${album.data.title} — BCARRION`}
  active="discografia"
  description={`Tracklist de ${album.data.title}: ${album.data.descriptionEs}`}
>
  <section class="relative z-10 pt-[180px] px-[6vw] pb-10 text-center">
    <p class="eyebrow mb-5">BCARRION</p>
    <h1 class="font-display font-bold text-[clamp(36px,6vw,64px)] m-0 text-fg">{album.data.title}</h1>
    <p class="text-muted max-w-[440px] mx-auto mt-5 text-sm leading-[1.7]">
      <span class="lang-es">{album.data.descriptionEs} · {releaseEs}</span>
      <span class="lang-en">{album.data.descriptionEn} · {releaseEn}</span>
    </p>
  </section>

  <section class="relative z-10 max-w-[640px] mx-auto py-[60px] px-[6vw] pb-[140px]">
    {tracks.map((track) => (
      <div class="group flex items-baseline gap-6 py-[22px] px-1 border-b border-border transition-colors duration-300 hover:border-fg">
        <div class="font-display text-sm text-faint w-5 transition-colors duration-300 group-hover:text-accent">{track.num}</div>
        <div class="flex-1 text-left">
          <div class="font-normal text-base text-fg transition-transform duration-300 group-hover:translate-x-1">{track.title}</div>
          {track.single && (
            <div class="mt-[6px]">
              <span class="tag-accent"><span class="lang-es">SENCILLO</span><span class="lang-en">SINGLE</span></span>
            </div>
          )}
        </div>
        <div class="font-display text-faint text-[13px]">{track.duration}</div>
      </div>
    ))}

    <div class="text-center mt-[72px]">
      <a href="/discografia" class="cta-outline">
        <span class="lang-es">← Ver discografía completa</span><span class="lang-en">← Back to discography</span>
      </a>
    </div>
  </section>
</BaseLayout>
