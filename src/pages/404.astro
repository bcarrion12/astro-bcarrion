---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — BCARRION" description="Página no encontrada.">
  <section class="relative z-10 min-h-screen flex flex-col items-center justify-center px-[6vw] text-center overflow-hidden">
    <div class="marquee absolute top-[70px] left-0 pointer-events-none select-none" aria-hidden="true">
      <div class="marquee-track">
        <span>404 · Fuera de órbita · 404 · Fuera de órbita · </span>
        <span>404 · Fuera de órbita · 404 · Fuera de órbita · </span>
      </div>
    </div>
    <p class="eyebrow mb-7">
      <span class="lang-es">Fuera de órbita</span><span class="lang-en">Off orbit</span>
    </p>
    <h1 class="font-display font-bold text-[clamp(64px,14vw,160px)] leading-none m-0 text-fg">404</h1>
    <p class="my-8 max-w-[420px] text-muted text-[15px] leading-[1.7]">
      <span class="lang-es">Esta página no existe o se perdió en el camino entre galaxias.</span>
      <span class="lang-en">This page doesn't exist, or got lost somewhere between galaxies.</span>
    </p>
    <a href="/" class="cta-solid">
      <span class="lang-es">Volver al inicio</span><span class="lang-en">Back home</span>
    </a>
  </section>
</BaseLayout>
