---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import artistPhoto from '../assets/artist.png';

const albums = await getCollection('albums', ({ data }) => data.published && data.current);
const currentAlbum = albums[0];
const trackCount = currentAlbum?.data.tracks.length ?? 0;
const releaseShort = currentAlbum
  ? `${String(currentAlbum.data.releaseDate.getUTCDate()).padStart(2, '0')}.${String(currentAlbum.data.releaseDate.getUTCMonth() + 1).padStart(2, '0')}`
  : '';
---
<BaseLayout title="Sobre — BCARRION" active="sobre" description="Sobre bcarrion: biografía del artista detrás de Andromeda.">
  <section class="relative z-10 grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-20 items-center max-w-[1080px] mx-auto pt-[180px] px-[6vw] pb-[80px]">
    <div class="w-full aspect-square overflow-hidden rounded-sm border border-border">
      <Image
        src={artistPhoto}
        alt="bcarrion, el artista detrás de Andromeda"
        widths={[400, 700, 1000]}
        sizes="(min-width: 768px) 45vw, 90vw"
        format="webp"
        quality={80}
        class="w-full h-full object-cover"
      />
    </div>
    <div>
      <p class="eyebrow mb-5">
        <span class="lang-es">Sobre el artista</span><span class="lang-en">About the artist</span>
      </p>
      <h1 class="font-display font-bold text-[clamp(30px,4.5vw,48px)] mb-6 text-fg">BCARRION</h1>
      <p class="text-muted text-[15px] leading-[1.8] max-w-[440px]">
        <span class="lang-es">bcarrion explora los límites entre lo electrónico y lo orgánico. Andromeda es su álbum más ambicioso: ocho pistas que orbitan entre sintetizadores cálidos y percusión precisa, un mapa sonoro de un viaje interior contado a escala cósmica.</span>
        <span class="lang-en">bcarrion explores the line between electronic and organic. Andromeda is the most ambitious record yet: eight tracks orbiting warm synths and precise percussion, a sonic map of an inner journey told at cosmic scale.</span>
      </p>
      <div class="flex gap-2 flex-wrap mt-7">
        <span class="tag-accent"><span class="lang-es">ELECTRÓNICA</span><span class="lang-en">ELECTRONIC</span></span>
        <span class="tag-accent"><span class="lang-es">DESDE 2019</span><span class="lang-en">SINCE 2019</span></span>
      </div>
    </div>
  </section>

  <section class="relative z-10 max-w-[1080px] mx-auto px-[6vw] pb-[150px]">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 text-center">
      <div class="card">
        <div class="font-display font-bold text-[28px] text-fg mb-1">{trackCount}</div>
        <div class="text-faint text-[11px] tracking-[.15em] uppercase">
          <span class="lang-es">Pistas en Andromeda</span><span class="lang-en">Tracks on Andromeda</span>
        </div>
      </div>
      <div class="card">
        <div class="font-display font-bold text-[28px] text-fg mb-1">2019</div>
        <div class="text-faint text-[11px] tracking-[.15em] uppercase">
          <span class="lang-es">Primer lanzamiento</span><span class="lang-en">First release</span>
        </div>
      </div>
      <div class="card">
        <div class="font-display font-bold text-[28px] text-fg mb-1">{releaseShort}</div>
        <div class="text-faint text-[11px] tracking-[.15em] uppercase">
          <span class="lang-es">Fecha de Andromeda</span><span class="lang-en">Andromeda release date</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
